# Copia este archivo como .env (ElevenLabs) y .env.local (Higgsfield) y pon tus claves.
# Ninguno de los dos se sube a GitHub.
ELEVENLABS_API_KEY=

# Opcional: ID de la voz. Si lo dejas vacío, el script busca "Lina - Sunny, Kind and Friendly".
ELEVENLABS_VOICE_ID=

# Higgsfield (clips con Seedance 2.5). Esta va en un archivo aparte: .env.local
# (tampoco se sube a GitHub). Pega la clave tal como la copias de
# open.higgsfield.ai/api-keys, con formato key-id:key-secret.
HF_CREDENTIALS=
